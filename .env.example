# Copy to .env and edit. All variables use the NURSERY_ prefix.
NURSERY_PORT=7860
# Leave empty unless served behind a proxy / sub-path
NURSERY_PUBLIC_BASE_URL=

# LLM: "api" or "llamacpp"
NURSERY_LLM_MODE=api
NURSERY_API_BASE_URL=https://api.openai.com/v1
# Your own key goes here (never commit .env)
NURSERY_API_KEY=
NURSERY_API_MODEL=
NURSERY_LLAMACPP_MODEL_PATH=
NURSERY_LLAMACPP_N_CTX=8192
NURSERY_LLAMACPP_N_GPU_LAYERS=-1

# Segmentation: "sam3" or "mock"
NURSERY_SEG_BACKEND=sam3
NURSERY_SAM3_CHECKPOINT=
NURSERY_TILE_SIZE=1024
NURSERY_TILE_OVERLAP=128
NURSERY_MIN_SCORE=0.5
# Counting: ground-area thresholds for the merged raster (m^2)
NURSERY_MIN_OBJECT_AREA_M2=1.0
NURSERY_MAX_HOLE_AREA_M2=1.0
NURSERY_MASK_MAX_PIXELS=250000000
NURSERY_PLAIN_IMAGE_PIXEL_SIZE_M=1.0
# PMF (DEM -> DTM) used for tree height
NURSERY_PMF_CELL_SIZE_M=1.0
NURSERY_PMF_MAX_WINDOW_M=20.0
NURSERY_PMF_SLOPE=0.15
NURSERY_PMF_INITIAL_DH_M=0.15
NURSERY_PMF_MAX_DH_M=3.0
