{
  "asset_ledger": {
    "label": "Area Nursery Asset Ledger",
    "title": "{region_name} Nursery Asset Ledger",
    "default_region_name": "Area",
    "meta": [
      [
        "Area name",
        "{region_display}"
      ],
      [
        "Valuation date",
        "{date}"
      ],
      [
        "Data source",
        "{image_name}"
      ],
      [
        "Valuation method",
        "{mode_text}"
      ]
    ],
    "needs_price": true,
    "sheets": [
      {
        "name": "Asset Ledger",
        "source": "trees",
        "columns": [
          {
            "header": "No.",
            "field": "index",
            "width": 8
          },
          {
            "header": "Species",
            "field": "species",
            "width": 22
          },
          {
            "header": "Equivalent crown width (m)",
            "field": "crown_d_m",
            "width": 26,
            "format": "0.00"
          },
          {
            "header": "Tree height (m)",
            "field": "height_m",
            "width": 16,
            "format": "0.00",
            "requires": "dem"
          },
          {
            "header": "Price (CNY)",
            "field": "price",
            "width": 24,
            "format": "#,##0.00"
          }
        ],
        "total": {
          "label": "Total ({n} trees)",
          "sum_fields": [
            "price"
          ]
        }
      },
      {
        "name": "Species Summary",
        "source": "species",
        "columns": [
          {
            "header": "No.",
            "field": "index",
            "width": 8
          },
          {
            "header": "Species",
            "field": "species",
            "width": 22
          },
          {
            "header": "Count",
            "field": "count",
            "width": 12,
            "format": "0"
          },
          {
            "header": "Avg. unit price (CNY/tree)",
            "field": "avg_price",
            "width": 28,
            "format": "#,##0.00"
          },
          {
            "header": "Asset value (CNY)",
            "field": "value",
            "width": 24,
            "format": "#,##0.00"
          }
        ],
        "total": {
          "label": "Total",
          "sum_fields": [
            "count",
            "value"
          ]
        }
      }
    ]
  },
  "plot_census": {
    "label": "Plot Census Report",
    "title": "{region_name} Census Report",
    "default_region_name": "Plot",
    "meta": [
      [
        "Plot name",
        "{region_display}"
      ],
      [
        "Census date",
        "{date}"
      ],
      [
        "Data source",
        "{image_name}"
      ]
    ],
    "sheets": [
      {
        "name": "Census Report",
        "source": "species",
        "columns": [
          {
            "header": "No.",
            "field": "index",
            "width": 8
          },
          {
            "header": "Species",
            "field": "species",
            "width": 22
          },
          {
            "header": "Count",
            "field": "count",
            "width": 10,
            "format": "0"
          },
          {
            "header": "Share (%)",
            "field": "share_pct",
            "width": 12,
            "format": "0.00"
          },
          {
            "header": "Mean crown width (m)",
            "field": "mean_crown_d_m",
            "width": 22,
            "format": "0.00"
          },
          {
            "header": "Total crown area (m²)",
            "field": "total_crown_area_m2",
            "width": 22,
            "format": "#,##0.00"
          }
        ],
        "total": {
          "label": "Total",
          "sum_fields": [
            "count",
            "share_pct",
            "total_crown_area_m2"
          ]
        }
      }
    ]
  }
}